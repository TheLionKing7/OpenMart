# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Server
PORT=3099

# Optional: set to true to allow POST /payments/:reference/simulate-success (dev only)
ALLOW_PAYMENT_SIMULATE=true

# Admin bearer token — required for GET /state and GET /leads (lead PII).
# Without it those endpoints answer 403. Use a long random string.
ADMIN_TOKEN=change-me

# Website (Vercel / Next.js) — point registration proxy at this API
# PLATFORM_API_URL is set on the website, not here. Example:
# PLATFORM_API_URL=http://localhost:3099
